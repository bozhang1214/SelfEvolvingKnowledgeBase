# ============================================================
# 自迭代个人知识库 Agent - 环境变量示例
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env
#   2. 填入真实的 API Key
#   3. .env 文件已被 gitignore，不会提交
#
# 本文件覆盖 backend 代码实际读取的全部环境变量（与
# docs/tech/06-CONFIG-REFERENCE.md 的「环境变量总表」互为对照）。
# 未列出的变量都有代码内置默认值，无需配置。
# ============================================================

# ============ 必需：LLM + 联网搜索 ============
# DeepSeek API Key：从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# 博查搜索 API Key：从 https://open.bochaai.com 获取（联网搜索工具用）
BOCHA_API_KEY=sk-your-bocha-key-here

# ============ 鉴权（生产必需）============
# JWT 密钥。留空会回退到弱默认值，启动时会被强度校验拒绝；生产必须设强随机串（≥32 字符）。
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret

# ⚠️ 用户白名单（逗号分隔邮箱）——**最容易被忽略、后果最明显的一个开关**：
#   - 留空（默认）：所有登录用户都拥有完整功能；
#   - 一旦填写：**名单外**的账号会被降级为「预览」权限——只能看科技资讯，
#     看不到 AI 对话 / 文件 / 知识库 / 职位分析（点进去会提示需完整权限）。
#   自己新注册的号如果没写进这里，就会「功能凭空消失」，请务必确认。
ALLOWED_EMAILS=

# ============ 功能开关（一般无需改）============
# JD 截图图片分析：默认开启
IMAGE_ANALYSIS_ENABLED=true
# OCR（图片文字识别）：默认开启，lang=ch（中英）/ en（英文）
OCR_ENABLED=true
OCR_LANG=ch
# 资讯任务失败告警的飞书网关地址。默认已开启并走同网网关
# （http://sekb-feishu-webhook:5001/webhook）；设为 off / none / 0 可关闭。
# NEWS_ALERT_WEBHOOK_URL=off

# ============ 视觉模型（图片理解/OCR 用，可选）============
# 不配 api_key 时降级为「基于 OCR 文本的简单标签」；需要图片理解时另配。
VISION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_API_KEY=
VISION_LLM_MODEL=qwen-vl-plus

# ============ 可选调优：博查搜索 ============
# 不设则用代码内置默认值（端点=官方、返回 5 条、超时 10s、重试 2 次）
# BOCHA_ENDPOINT=https://api.bochaai.com/v1/web-search
# BOCHA_MAX_RESULTS=5
# BOCHA_TIMEOUT_SECONDS=10
# BOCHA_MAX_RETRIES=2

# ============ 可选：链路追踪 ============
# LangSmith：不设 key 时自动降级为本地 JSON trace（不影响功能）
LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=
# LANGSMITH_PROJECT=

# ============ 可选：路径覆盖 ============
# 审计日志目录（默认 data/audit）
# SEKB_AUDIT_DIR=
# 配置文件路径（默认 config.yaml，容器内一般不用改）
# SEKB_CONFIG_PATH=

# ============ 可选：数据库（仅 profile=with-db 时需要）============
# DATABASE_URL=postgresql://user:password@localhost:5432/self_evolving_kb
