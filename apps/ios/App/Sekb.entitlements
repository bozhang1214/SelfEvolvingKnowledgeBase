<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 只留 application-identifier：带 keychain-access-groups 时，模拟器会拒绝启动
         手搓 ad-hoc 签名的 App（SBMainWorkspace 拒绝，实测）。 -->
    <key>application-identifier</key>
    <string>com.sekb.ondevice.ios</string>
</dict>
</plist>
