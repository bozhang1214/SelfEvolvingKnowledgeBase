# HAP 工程的构建产物不入库。
# 用**嵌套 .gitignore**而不是改根 .gitignore：根 .gitignore 是多人共用的热点文件
# （本仓库此刻就有人正在改它），嵌套文件的冲突面为零。
/entry/build/
# libkn.so 由 `bash scripts/harmony_spike.sh kn` 从 KMP 产物拷贝而来，
# 属于可再生的构建产物 → 不入库（fresh clone 先跑一次 kn 即可）。
/entry/libs/
/.hvigor/
/.idea/
/oh_modules/
/build/
/entry/.cxx/
# native 构建（BuildNativeWithCmake）自动生成的 clang 工具配置
.clangd
.clang-tidy
/entry/.preview/
# 由 scripts/harmony_spike.sh hap 放进来的模型（94MB 构建产物）
/entry/src/main/resources/rawfile/*.ms
# H2：契约夹具（apps/contract/*.json）由 build_hap 拷进来——**只引用不复制**，
# 所以不入库。入库就等于制造第二份夹具，正是 apps/contract/README.md 反对的事。
/entry/src/main/resources/rawfile/contract/
