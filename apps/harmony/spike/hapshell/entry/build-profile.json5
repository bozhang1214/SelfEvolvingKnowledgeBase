{
  "apiType": "stageMode",
  "buildOption": {
    // 编 NAPI 模块（libknspike.so），它在 CMake 里链上 KMP 产物 libkn.so
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      // **只编 arm64-v8a**（C4，owner 2026-10-25 拍板）：本机模拟器实例 nova 16 Pro 的
      // abi 就是 arm（~/.Huawei/Emulator/deployed/lists.json），x86_64 那份用不上；
      // 保留它还会让 HAP 多带一份 native 体积。真要 x86_64 开发机时再加回来，
      // 同时要给 knspike 与 apps/shared-core 各加回 ohosX64 目标。
      "abiFilters": ["arm64-v8a"]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": ["./obfuscation-rules.txt"]
          }
        }
      }
    }
  ],
  "targets": [
    { "name": "default" }
  ]
}
