# ============================================================
# 自迭代个人知识库 Agent - .gitignore
# ============================================================

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============ 虚拟环境 ============
venv/
env/
ENV/
.venv/
.env

# ============ IDE ============
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ============ 测试 ============
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
tests/reports/

# ============ 运行时数据 ============
backend/data/
!backend/data/.gitkeep

# ============ 环境变量 ============
.env
.env.local
.env.*.local
.env.prod

# ============ Docker ============
deploy/certs/

# ============ 前端 ============
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ============ 日志 ============
*.log
logs/

# TypeScript 增量构建缓存
*.tsbuildinfo

# ============ 个人资料（不进版本库）============
resume/

# ============ 临时草稿文档（本地留存，不进版本库）============
docs/tmp/

# 注：jobcopilot 是 git **子模块**（见 .gitmodules），由 git 管理，不能再进 gitignore。
# 构建期需要它存在于仓库根：git submodule update --init
