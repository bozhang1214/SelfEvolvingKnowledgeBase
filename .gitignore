# ============================================================
# 自迭代个人知识库 Agent - .gitignore
# ============================================================

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============ 虚拟环境 ============
venv/
env/
ENV/
.venv/
.env

# ============ IDE ============
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ============ 测试 ============
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
tests/reports/

# ============ 运行时数据 ============
backend/data/
!backend/data/.gitkeep

# ============ 环境变量 ============
.env
.env.local
.env.*.local
.env.prod
# .env.prod 的备份**含真实密钥**（JWT_SECRET 等），绝不能被 git add 卷进来。
# 备份请放仓库外（生产上已移到 /opt/self-evolving-kb/env-backups/）。
.env.prod.bak*
*.pre-deploy-*.bak

# ============ Docker ============
deploy/certs/

# ============ JobCopilot 提示词分发产物（由 jobcopilot publish 生成，不进版本库）============
prompts-dist/

# ============ 前端 ============
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ============ 日志 ============
*.log
logs/

# TypeScript 增量构建缓存
*.tsbuildinfo

# ============ 端侧构建状态（apps/*/ 各构建目录自己的 .gitignore 覆盖不全）============
# 2026-10-25 补：`apps/shared/.gradle/`、`apps/android/.gradle|.kotlin/` 当时**没有被任何规则忽略**
# （只有 `apps/harmony/spike/.gitignore` 写了 `.gradle/`），于是它们会以噪音形式出现在
# 每个人的 `git status` 里。这些是**本机构建状态**，与 AGENTS.md §1 的 `.tooling/` 同理：
# 不进版本库，也别清理别人的缓存。
.gradle/
.kotlin/
oh_modules/
local.properties

# ============ 个人资料 / 求职材料（不进版本库）============
resume/
docs/JobHunting/

# ============ 临时草稿文档（本地留存，不进版本库）============
docs/tmp/

# 注：jobcopilot 是 git **子模块**（见 .gitmodules），由 git 管理，不能再进 gitignore。
# 构建期需要它存在于仓库根：git submodule update --init
