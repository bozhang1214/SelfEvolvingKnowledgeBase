# ============================================================
# 前端 Docker 构建上下文排除清单
# ============================================================
# 减小发送到 Docker daemon 的上下文体积，加速镜像构建
# ============================================================

# ---- 依赖与构建产物（构建期会重新生成）----
node_modules/
dist/
.vite/

# ---- 缓存 ----
.npm/
.eslintcache
*.tsbuildinfo

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ---- 环境变量与密钥 ----
.env
.env.local
.env.*.local
.env.project

# ---- 日志 ----
*.log
logs/

# ---- 版本控制 ----
.git/
.gitignore
.gitattributes

# ---- 测试相关 ----
coverage/
.nyc_output/

# ---- 文档（镜像中不需要）----
../docs/
