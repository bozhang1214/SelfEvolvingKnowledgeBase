# ============================================================
# 自迭代个人知识库 Agent - 生产环境变量模板
# ============================================================
# 使用方法：
#   1. 复制本文件为项目根目录的 .env.prod
#      cp deploy/.env.prod.example .env.prod
#   2. 填入真实密钥（务必修改所有 *-change-me 占位符）
#   3. 启动服务：
#      docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# 安全提示：
#   - .env.prod 已被 .gitignore 排除，不会提交到版本控制
#   - 生产环境务必使用强随机密钥（推荐：openssl rand -hex 32）
# ============================================================

# ============ 必需密钥 ============

# DeepSeek API Key（LLM 主力模型）
# 获取地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-change-me

# 博查搜索 API Key（联网搜索工具）
# 获取地址：https://open.bochaai.com
BOCHA_API_KEY=sk-your-bocha-key-change-me

# JWT 签名密钥（用户鉴权 token 签发与校验）
# 生成强随机密钥：openssl rand -hex 32
JWT_SECRET=please-change-me-to-a-strong-random-secret

# ============ 可选：链路追踪 ============

# LangSmith API Key（在线 trace 可视化，不设置则降级到本地 JSON trace）
# 获取地址：https://smith.langchain.com
LANGSMITH_API_KEY=

# ============ 可选：镜像版本与端口 ============

# 镜像 tag（CI/CD 注入 git sha 时使用，默认 latest）
TAG=latest

# 前端对外暴露端口（默认 80，HTTPS 部署可改为 443）
FRONTEND_PORT=80

# ============ 可选：告警通知（飞书 + 邮件）============

# 飞书机器人 webhook 地址（不设置则告警仅记录到 Alertmanager，不推送飞书）
# 获取方式：飞书群 → 群设置 → 群机器人 → 添加自定义机器人 → 复制 webhook 地址
FEISHU_WEBHOOK_URL=

# 飞书机器人签名密钥（启用了安全设置时填写）
FEISHU_SECRET=

# 邮件通知 SMTP 配置（可选）
SMTP_HOST=
SMTP_FROM=alert@sekb.local
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=admin@sekb.local

# ============ 可选：数据库（仅 profile=with-db 时需要）============

# 当后端从 local_json 迁移到 PostgreSQL 时启用
DB_USER=sekb
DB_PASSWORD=change-me-to-a-strong-db-password
DB_NAME=sekb

# ============ 可选：图片处理（OCR + 多模态标签）============

# 图片分析总开关（true 启用 OCR 文字提取和标签生成）
IMAGE_ANALYSIS_ENABLED=true

# OCR 文字提取开关（true 启用 PaddleOCR）
OCR_ENABLED=true

# OCR 识别语言（ch=中英文，en=英文）
OCR_LANG=ch

# 视觉模型配置（OpenAI 兼容接口，支持通义千问 VL / GPT-4o 等）
# 不配置 api_key 时，降级为基于 OCR 文本的简单标签（无需视觉模型）
# 通义千问 VL 获取地址：https://dashscope.console.aliyun.com/
VISION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_API_KEY=
VISION_LLM_MODEL=qwen-vl-plus
